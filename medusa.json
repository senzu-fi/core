{
  "fuzzing": {
    "workers": 4,
    "workerResetLimit": 50,
    "timeout": 900,
    "testLimit": 0,
    "shrinkLimit": 5000,
    "callSequenceLength": 100,
    "pruneFrequency": 5,
    "corpusDirectory": "medusa-corpus",
    "coverageEnabled": true,
    "coverageFormats": [
      "html",
      "lcov"
    ],
    "coverageExclusions": [],
    "revertReporterEnabled": false,
    "targetContracts": [
      "V3Medusa"
    ],
    "predeployedContracts": {},
    "targetContractsBalances": [],
    "constructorArgs": {},
    "deployerAddress": "0x30000",
    "senderAddresses": [
      "0x10000",
      "0x20000",
      "0x30000"
    ],
    "blockNumberDelayMax": 100,
    "blockTimestampDelayMax": 3600,
    "transactionGasLimit": 200000000,
    "testing": {
      "stopOnFailedTest": true,
      "stopOnFailedContractMatching": false,
      "stopOnNoTests": true,
      "testAllContracts": false,
      "testViewMethods": false,
      "verbosity": 1,
      "assertionTesting": {
        "enabled": true,
        "panicCodeConfig": {
          "failOnCompilerInsertedPanic": false,
          "failOnAssertion": true,
          "failOnArithmeticUnderflow": false,
          "failOnDivideByZero": false,
          "failOnEnumTypeConversionOutOfBounds": false,
          "failOnIncorrectStorageAccess": false,
          "failOnPopEmptyArray": false,
          "failOnOutOfBoundsArrayAccess": false,
          "failOnAllocateTooMuchMemory": false,
          "failOnCallUninitializedVariable": false
        }
      },
      "propertyTesting": {
        "enabled": true,
        "testPrefixes": [
          "property_"
        ]
      },
      "optimizationTesting": {
        "enabled": false,
        "testPrefixes": [
          "optimize_"
        ]
      },
      "targetFunctionSignatures": [],
      "excludeFunctionSignatures": [
        "V2Medusa.senzuLockAcquired(bytes)",
        "V2Medusa.unwindAll()",
        "V2MedusaUsdcToken0.senzuLockAcquired(bytes)",
        "V2MedusaUsdcToken0.unwindAll()",
        "V2EmptyMarketMedusa.senzuLockAcquired(bytes)",
        "V2EmptyMarketMedusa.unwindAll()",
        "V3Medusa.senzuLockAcquired(bytes)",
        "V3Medusa.unwindAll()",
        "V3MedusaUsdcToken0.senzuLockAcquired(bytes)",
        "V3MedusaUsdcToken0.unwindAll()",
        "V3EmptyMarketMedusa.senzuLockAcquired(bytes)",
        "V3EmptyMarketMedusa.unwindAll()",
        "V4Medusa.senzuLockAcquired(bytes)",
        "V4Medusa.unwindAll()",
        "V4MedusaErc20.senzuLockAcquired(bytes)",
        "V4MedusaErc20.unwindAll()",
        "V4EmptyMarketMedusa.senzuLockAcquired(bytes)",
        "V4EmptyMarketMedusa.unwindAll()",
        "AeroMedusa.step(uint256)",
        "AeroMedusa.unwindAll()"
      ]
    },
    "chainConfig": {
      "codeSizeCheckDisabled": true,
      "cheatCodes": {
        "cheatCodesEnabled": true,
        "enableFFI": false
      },
      "skipAccountChecks": true,
      "forkConfig": {
        "forkModeEnabled": false,
        "rpcUrl": "",
        "rpcBlock": 1,
        "poolSize": 20
      }
    },
    "blockGasLimit": 1000000000
  },
  "compilation": {
    "platform": "crytic-compile",
    "platformConfig": {
      "target": ".",
      "solcVersion": "",
      "exportDirectory": "",
      "args": [
        "--foundry-compile-all"
      ]
    }
  },
  "slither": {
    "useSlither": false,
    "cachePath": "slither_results.json",
    "args": []
  },
  "logging": {
    "level": "info",
    "logDirectory": "",
    "noColor": false
  }
}